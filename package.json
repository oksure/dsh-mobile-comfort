{
  "name": "@oksure/dsh-client-ui-mobile-comfort",
  "version": "0.1.3",
  "description": "Touch-device comfort fixes for the dsh web client: mobile sidebar overlay, touch targets, tooltip suppression, and tap behavior.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oksure/dsh-mobile-comfort.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.1.5-rc.2 || 0.1.7-rc.2",
      "dshReleases": {
        "0.1.5-rc.2": "compatible",
        "0.1.7-rc.2": "compatible"
      },
      "dshOperations": {
        "0.1.5-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "unknown"
        },
        "0.1.7-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "unknown"
        }
      }
    }
  }
}
